{
  "compilerOptions": {
    // Typecheck-only (esbuild emits the CJS bundle). "preserve" implies bundler-style
    // resolution, which vscode-languageclient v10+ needs for its "exports" subpaths.
    "module": "preserve",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "out"]
}
